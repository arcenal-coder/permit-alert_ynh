# Copy to /var/www/permit-alert/mail.env, owned by root, mode 0600.
# systemd reads this file before dropping privileges. Never commit credentials.
# Leave IMAP_HOST unset to disable incoming e-mail; web imports still work.
# Use the TLS hostname present in the mail server certificate, not localhost.
# PERMIT_ALERT_IMAP_HOST=mail.onyx-ingenierie.com
# PERMIT_ALERT_IMAP_PORT=993
# PERMIT_ALERT_IMAP_USER=epermit@onyx-ingenierie.com
# PERMIT_ALERT_IMAP_PASSWORD=replace-on-server
# PERMIT_ALERT_IMAP_FOLDER=INBOX
# PERMIT_ALERT_LDAP_GROUP=coordinateurs
# Optional valid sender address authorized by the server's mail policy:
# PERMIT_ALERT_SENDER=permit-alert@onyx-ingenierie.com
